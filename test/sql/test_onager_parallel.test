# group: [onager]

require onager
# Test suite for Onager parallel algorithms

statement ok
pragma enable_verification

# Create test edge data
statement ok
create table test_edges as select * from (values
  (1::bigint, 2::bigint), (2, 3), (3, 4), (4, 5), (1, 3), (2, 4), (3, 5)
) t(src, dst)

# Test parallel BFS returns nodes
query I
select count(*) > 0 from onager_par_pagerank((select src, dst from test_edges))
----
1

# Test parallel PageRank with a tolerance named parameter
query I
select count(*) > 0 from onager_par_pagerank((select src, dst from test_edges), tolerance := 1e-8)
----
1

# Test parallel BFS returns nodes
query I
select count(*) > 0 from onager_par_bfs((select src, dst from test_edges), source := 1)
----
1

# Test multi-source parallel BFS returns a source column
query I
select count(distinct source) from onager_par_bfs((select src, dst from test_edges), sources := [1, 2])
----
2

# Multi-source parallel BFS from one source must match single-source output
query I
select count(*) from (
  select node_id from onager_par_bfs((select src, dst from test_edges), sources := [1])
  except
  select node_id from onager_par_bfs((select src, dst from test_edges), source := 1)
)
----
0

# Test parallel BFS rejects passing both source and sources
statement error
select * from onager_par_bfs((select src, dst from test_edges), source := 1, sources := [1, 2])
----
Binder Error: onager_par_bfs: pass either source or sources, not both

# Test parallel shortest paths returns distances
query I
select count(*) > 0 from onager_par_shortest_paths((select src, dst from test_edges), source := 1)
----
1

# Test multi-source parallel shortest paths returns a source column
query I
select count(distinct source) from onager_par_shortest_paths((select src, dst from test_edges), sources := [1, 2])
----
2

# Multi-source parallel shortest paths from one source must match single-source output
query I
select count(*) from (
  select node_id, distance from onager_par_shortest_paths((select src, dst from test_edges), sources := [1])
  except
  select node_id, distance from onager_par_shortest_paths((select src, dst from test_edges), source := 1)
)
----
0

# Test parallel connected components
query I
select count(*) > 0 from onager_par_components((select src, dst from test_edges))
----
1

# All nodes should be in same component
query I
select count(distinct component) from onager_par_components((select src, dst from test_edges))
----
1

# Test parallel clustering coefficients
query I
select count(*) > 0 from onager_par_clustering((select src, dst from test_edges))
----
1

# Test parallel triangle count
query I
select count(*) > 0 from onager_par_triangles((select src, dst from test_edges))
----
1

# =============================================================================
# Directed Parameter
# =============================================================================

# Directed parallel BFS from the end of a directed path reaches only itself
query I
select count(*) from onager_par_bfs((select * from (values
    (1::bigint, 2::bigint), (2, 3)
  ) t(src, dst)), source := 3, directed := true)
----
1

# Directed parallel shortest paths on the cycle 1 -> 2 -> 3 -> 1 go the long way
query I
select distance from onager_par_shortest_paths((select * from (values
    (1::bigint, 2::bigint), (2, 3), (3, 1)
  ) t(src, dst)), source := 1, directed := true)
where node_id = 3
----
2.0

# Batch mode also accepts the directed parameter
query I
select count(distinct source) from onager_par_bfs((select * from (values
    (1::bigint, 2::bigint), (2, 3)
  ) t(src, dst)), sources := [1, 3], directed := true)
----
2

# Cleanup
statement ok
drop table test_edges
