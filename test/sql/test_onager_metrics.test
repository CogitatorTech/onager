# group: [onager]

require onager

# Test suite for Onager graph metrics

statement ok
pragma enable_verification

# Create test edge data - simple triangle with one extra edge (1-4)
statement ok
create table test_edges as select * from (values
  (1::bigint, 2::bigint), (2, 3), (3, 1),
  (1, 4)
) t(src, dst)

# Test Diameter
query I
select * from onager_mtr_diameter((select src, dst from test_edges))
----
2

# Test Radius
query I
select * from onager_mtr_radius((select src, dst from test_edges))
----
1

# Test Average Clustering
query R
select round(min(avg_clustering)::numeric, 2) from onager_mtr_avg_clustering((select src, dst from test_edges))
----
0.58

# Test Transitivity
query R
select round(min(transitivity)::numeric, 2) from onager_mtr_transitivity((select src, dst from test_edges))
----
0.60

# Test Triangle Counting
query I
select count(*) from onager_mtr_triangles((select src, dst from test_edges)) where triangles > 0
----
3

# Test Assortativity
query I
select count(assortativity) from onager_mtr_assortativity((select src, dst from test_edges))
----
1

# Test Average Path Length
query I
select min(avg_path_length) > 0 from onager_mtr_avg_path_length((select src, dst from test_edges))
----
true

# Test Graph Density (undirected)
query I
select min(density) > 0 from onager_mtr_density((select src, dst from test_edges))
----
true

# =============================================================================
# Directed Parameter
# =============================================================================

# Directed diameter on the cycle 1 -> 2 -> 3 -> 1 is 2; undirected it is 1
query I
select * from onager_mtr_diameter((select * from (values
    (1::bigint, 2::bigint), (2, 3), (3, 1)
  ) t(src, dst)), directed := true)
----
2

query I
select * from onager_mtr_diameter((select * from (values
    (1::bigint, 2::bigint), (2, 3), (3, 1)
  ) t(src, dst)))
----
1

# Directed radius on the same cycle is 2
query I
select * from onager_mtr_radius((select * from (values
    (1::bigint, 2::bigint), (2, 3), (3, 1)
  ) t(src, dst)), directed := true)
----
2

# Directed average path length on the cycle is larger than undirected
query I
select d.avg_path_length > u.avg_path_length
from onager_mtr_avg_path_length((select * from (values
    (1::bigint, 2::bigint), (2, 3), (3, 1)
  ) t(src, dst)), directed := true) d,
  onager_mtr_avg_path_length((select * from (values
    (1::bigint, 2::bigint), (2, 3), (3, 1)
  ) t(src, dst))) u
----
true

# Assortativity accepts the directed parameter
query I
select count(assortativity) from onager_mtr_assortativity((select src, dst from test_edges), directed := true)
----
1

# =============================================================================
# Undefined Metric Values
# =============================================================================

# Diameter and radius are NULL for a disconnected graph
query I
select * from onager_mtr_diameter((select * from (values
    (1::bigint, 2::bigint), (3, 4)
  ) t(src, dst)))
----
NULL

query I
select * from onager_mtr_radius((select * from (values
    (1::bigint, 2::bigint), (3, 4)
  ) t(src, dst)))
----
NULL

# A directed edge is not strongly connected, so the directed diameter is NULL
query I
select * from onager_mtr_diameter((select * from (values
    (1::bigint, 2::bigint)
  ) t(src, dst)), directed := true)
----
NULL

# Average path length is NULL for a disconnected graph
query I
select * from onager_mtr_avg_path_length((select * from (values
    (1::bigint, 2::bigint), (3, 4)
  ) t(src, dst)))
----
NULL

# Density treats the input as a simple graph: duplicate rows and reversed
# duplicates count once, and self-loops are ignored
query R
select round(density, 2) from onager_mtr_density((select * from (values
    (1::bigint, 2::bigint), (1, 2), (2, 1), (1, 1)
  ) t(src, dst)))
----
1.00

# Cleanup
statement ok
drop table test_edges
