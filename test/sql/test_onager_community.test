# group: [onager]


require onager
# Test suite for Onager community detection algorithms

statement ok
pragma enable_verification

# Create test edge data
statement ok
create table test_edges as select * from (values
  (1::bigint, 2::bigint), (2, 3), (3, 1), (3, 4)
) t(src, dst)

# Test Louvain community detection
query I
select count(*) > 0 from onager_cmm_louvain((select src, dst from test_edges))
----
1

# Test Connected Components
query I
select count(*) > 0 from onager_cmm_components((select src, dst from test_edges))
----
1

# Test Label Propagation
query I
select count(*) > 0 from onager_cmm_label_prop((select src, dst from test_edges))
----
1

# Test Label Propagation with max_iter and seed named parameters
query I
select count(*) > 0 from onager_cmm_label_prop((select src, dst from test_edges), max_iter := 50, seed := 42)
----
1

# Seeded label propagation must be deterministic
query I
select count(*) from (
  select * from onager_cmm_label_prop((select src, dst from test_edges), seed := 42)
  except
  select * from onager_cmm_label_prop((select src, dst from test_edges), seed := 42)
)
----
0

# Test Label Propagation rejects max_iter of zero
statement error
select * from onager_cmm_label_prop((select src, dst from test_edges), max_iter := 0)
----
Invalid Input Error: Label propagation failed: Invalid argument: max_iter must be positive

# Test Girvan-Newman community detection
query I
select count(*) > 0 from onager_cmm_girvan_newman((select src, dst from test_edges), communities := 2)
----
1

# Test Spectral clustering
query I
select count(*) > 0 from onager_cmm_spectral((select src, dst from test_edges), k := 2)
----
1

# Test Infomap community detection
query I
select count(*) > 0 from onager_cmm_infomap((select src, dst from test_edges))
----
1

# =============================================================================
# Community Empty Graph Edge Cases
# =============================================================================

# Louvain should return empty results for empty inputs
query I
select count(*) from onager_cmm_louvain((select src, dst from test_edges where false))
----
0

# Connected Components should return empty results for empty inputs
query I
select count(*) from onager_cmm_components((select src, dst from test_edges where false))
----
0

# Label Propagation should return empty results for empty inputs
query I
select count(*) from onager_cmm_label_prop((select src, dst from test_edges where false))
----
0

# Girvan-Newman should return empty results for empty inputs
query I
select count(*) from onager_cmm_girvan_newman((select src, dst from test_edges where false), communities := 2)
----
0

# Spectral clustering should return empty results for empty inputs
query I
select count(*) from onager_cmm_spectral((select src, dst from test_edges where false), k := 2)
----
0

# Infomap should return empty results for empty inputs
query I
select count(*) from onager_cmm_infomap((select src, dst from test_edges where false))
----
0

# Cleanup
statement ok
drop table test_edges
