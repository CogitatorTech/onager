# group: [onager]

require onager

# Test suite for Onager graph registry
# Note: Graph registry functions have global state, so we test them carefully
# to work with DuckDB's query verification system.

statement ok
pragma enable_verification

# Test onager_version
query I
select onager_version() != ''
----
1

# Test onager_version returns varchar type
query T
select typeof(onager_version())
----
VARCHAR

# Test onager_last_error returns varchar type
query T
select typeof(onager_last_error())
----
VARCHAR

# =============================================================================
# Graph Registry Management Tests
# =============================================================================
# These tests verify that graph management functions exist and return expected types.
# We disable verification for these stateful operations.

statement ok
pragma disable_verification

# Test that create_graph returns 0 for success
query I
select onager_create_graph('sqltest_graph_1', true)
----
0

# Test that list_graphs returns the registered graph
query I
select onager_list_graphs()
----
["sqltest_graph_1"]

# Test that node_count returns 0 for empty graph
query I
select onager_node_count('sqltest_graph_1')
----
0

# Test that edge_count returns 0 for empty graph
query I
select onager_edge_count('sqltest_graph_1')
----
0

# Test that add_node returns 0 for success
query I
select onager_add_node('sqltest_graph_1', 100)
----
0

query I
select onager_add_node('sqltest_graph_1', 101)
----
0

# Test that add_edge returns 0 for success
query I
select onager_add_edge('sqltest_graph_1', 100, 101, 1.5)
----
0

# Test degrees
query I
select onager_node_in_degree('sqltest_graph_1', 101)
----
1

query I
select onager_node_out_degree('sqltest_graph_1', 100)
----
1

# Test that node_count and edge_count match
query I
select onager_node_count('sqltest_graph_1')
----
2

query I
select onager_edge_count('sqltest_graph_1')
----
1

# Test that drop_graph returns 0 for success
query I
select onager_drop_graph('sqltest_graph_1')
----
0

# Test error cases - non-existent graph returns NULL
query I
select onager_node_count('definitely_not_a_real_graph_name_12345')
----
NULL

query I
select onager_edge_count('definitely_not_a_real_graph_name_12345')
----
NULL

query I
select onager_node_in_degree('definitely_not_a_real_graph_name_12345', 1)
----
NULL

query I
select onager_node_out_degree('definitely_not_a_real_graph_name_12345', 1)
----
NULL

statement ok
pragma enable_verification
