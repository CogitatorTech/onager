# group: [onager]


require onager
# Test suite for Onager centrality algorithms

statement ok
pragma enable_verification

# Create test edge data
statement ok
create table test_edges as select * from (values
  (1::bigint, 2::bigint), (2, 3), (3, 1), (3, 4)
) t(src, dst)

# Test PageRank returns results
query I
select count(*) > 0 from onager_ctr_pagerank((select src, dst from test_edges))
----
1

# Test PageRank with filtered input (selection vector verification)
query I
select count(*) from onager_ctr_pagerank((select src, dst from test_edges where src > 1)) where node_id = 4
----
1

# Test PageRank with a tolerance named parameter
query I
select count(*) > 0 from onager_ctr_pagerank((select src, dst from test_edges), tolerance := 1e-8)
----
1

# Test weighted PageRank accepts a third DOUBLE column
query I
select count(*) > 0 from onager_ctr_pagerank((select src, dst, 1.0::double as weight from test_edges))
----
1

# Weighted PageRank with a heavier edge to node 3 must rank node 3 above node 2
query I
select r3.rank > r2.rank
from onager_ctr_pagerank((select * from (values
    (1::bigint, 2::bigint, 1.0::double), (1, 3, 10.0)
  ) t(src, dst, weight))) r3,
  onager_ctr_pagerank((select * from (values
    (1::bigint, 2::bigint, 1.0::double), (1, 3, 10.0)
  ) t(src, dst, weight))) r2
where r3.node_id = 3 and r2.node_id = 2
----
1

# Uniform weights must match the unweighted ranks
query I
select count(*) from (
  select node_id, round(rank, 6) as rank from onager_ctr_pagerank((select src, dst, 1.0::double from test_edges))
  except
  select node_id, round(rank, 6) as rank from onager_ctr_pagerank((select src, dst from test_edges))
)
----
0


# Test Degree Centrality
query I
select count(*) > 0 from onager_ctr_degree((select src, dst from test_edges))
----
1

# Test Betweenness Centrality
query I
select count(*) > 0 from onager_ctr_betweenness((select src, dst from test_edges))
----
1

# Test Closeness Centrality
query I
select count(*) > 0 from onager_ctr_closeness((select src, dst from test_edges))
----
1

# Test Harmonic Centrality
query I
select count(*) > 0 from onager_ctr_harmonic((select src, dst from test_edges))
----
1

# Test Katz Centrality
query I
select count(*) > 0 from onager_ctr_katz((select src, dst from test_edges), alpha := 0.1)
----
1

# Test Katz Centrality with a beta named parameter
query I
select count(*) > 0 from onager_ctr_katz((select src, dst from test_edges), alpha := 0.1, beta := 2.0)
----
1

# Katz with the default beta of 1.0 must match the implicit default
query I
select count(*) from (
  select node_id, round(katz, 6) as katz from onager_ctr_katz((select src, dst from test_edges), alpha := 0.1, beta := 1.0)
  except
  select node_id, round(katz, 6) as katz from onager_ctr_katz((select src, dst from test_edges), alpha := 0.1)
)
----
0

# Test Eigenvector Centrality
query I
select count(*) > 0 from onager_ctr_eigenvector((select src, dst from test_edges))
----
1

# Test VoteRank
query I
select count(*) > 0 from onager_ctr_voterank((select src, dst from test_edges), num_seeds := 3)
----
1

# Test Local Reaching Centrality
query I
select count(*) > 0 from onager_ctr_local_reaching((select src, dst from test_edges), distance := 2)
----
1

# Test Laplacian Centrality
query I
select count(*) > 0 from onager_ctr_laplacian((select src, dst from test_edges))
----
1

# =============================================================================
# Centrality Empty Graph Edge Cases
# =============================================================================

# PageRank should return empty results for empty inputs without throwing error
query I
select count(*) from onager_ctr_pagerank((select src, dst from test_edges where false))
----
0

# Degree centrality should return empty results for empty inputs without throwing error
query I
select count(*) from onager_ctr_degree((select src, dst from test_edges where false))
----
0

# Betweenness centrality should return empty results for empty inputs
query I
select count(*) from onager_ctr_betweenness((select src, dst from test_edges where false))
----
0

# Closeness centrality should return empty results for empty inputs
query I
select count(*) from onager_ctr_closeness((select src, dst from test_edges where false))
----
0

# Eigenvector centrality should return empty results for empty inputs
query I
select count(*) from onager_ctr_eigenvector((select src, dst from test_edges where false))
----
0

# Katz centrality should return empty results for empty inputs
query I
select count(*) from onager_ctr_katz((select src, dst from test_edges where false), alpha := 0.1)
----
0

# Harmonic centrality should return empty results for empty inputs
query I
select count(*) from onager_ctr_harmonic((select src, dst from test_edges where false))
----
0

# =============================================================================
# Directed Parameter
# =============================================================================

# Degree defaults to undirected: in_degree equals out_degree for every node
query I
select count(*) from onager_ctr_degree((select src, dst from test_edges)) where in_degree <> out_degree
----
0

# Directed degree on a star 1 -> {2, 3, 4}: the hub has out_degree 3 and in_degree 0
query II
select in_degree, out_degree from onager_ctr_degree((select * from (values
    (1::bigint, 2::bigint), (1, 3), (1, 4)
  ) t(src, dst)), directed := true) where node_id = 1
----
0	3

# Directed harmonic on a path 1 -> 2 -> 3: node 3 reaches nothing, so it scores zero
query I
select harmonic from onager_ctr_harmonic((select * from (values
    (1::bigint, 2::bigint), (2, 3)
  ) t(src, dst)), directed := true) where node_id = 3
----
0.0

# Directed and undirected PageRank differ on an asymmetric graph
query I
select count(*) > 0 from (
  select node_id, round(rank, 6) as rank from onager_ctr_pagerank((select * from (values
      (1::bigint, 2::bigint), (1, 3), (2, 3)
    ) t(src, dst)), directed := true)
  except
  select node_id, round(rank, 6) as rank from onager_ctr_pagerank((select * from (values
      (1::bigint, 2::bigint), (1, 3), (2, 3)
    ) t(src, dst)))
)
----
1

# The remaining centrality functions accept the directed parameter
query I
select count(*) > 0 from onager_ctr_betweenness((select src, dst from test_edges), directed := true)
----
1

query I
select count(*) > 0 from onager_ctr_closeness((select src, dst from test_edges), directed := true)
----
1

query I
select count(*) > 0 from onager_ctr_eigenvector((select src, dst from test_edges), directed := true)
----
1

query I
select count(*) > 0 from onager_ctr_katz((select src, dst from test_edges), alpha := 0.1, directed := true)
----
1

query I
select count(*) > 0 from onager_ctr_voterank((select src, dst from test_edges), num_seeds := 2, directed := true)
----
1

query I
select count(*) > 0 from onager_ctr_local_reaching((select src, dst from test_edges), distance := 2, directed := true)
----
1

query I
select count(*) > 0 from onager_ctr_laplacian((select src, dst from test_edges), directed := true)
----
1

# Cleanup
statement ok
drop table test_edges
